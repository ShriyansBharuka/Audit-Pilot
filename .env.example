# Copy to .env (never commit .env). See vault/07 §2 and vault/10.

# MCP server
PORT=8000
PUBLIC_HOST=localhost                    # tunnel host, e.g. abc.trycloudflare.com
PUBLIC_URL=http://localhost:8000/mcp
IDENTITIES=identities.json               # generated by: python -m app.seed --reset
PIPELINE_MODE=inline                     # inline = run the audit pipeline in-process on upload
PORTAL_SECRET=change-me                  # HMAC key for mock IRP signatures

# n8n (optional)
N8N_WEBHOOK_URL=
N8N_SECRET=change-me

# OpenAI (optional; the whole system works with LLM_ENABLED=0)
LLM_ENABLED=0
OPENAI_API_KEY=                          # project-scoped key with a budget alert
OPENAI_MODEL_DEV=                        # e.g. the GPT-6.1 Sol id from client.models.list()
OPENAI_MODEL_DEMO=                       # GPT-6 Astra id (final demo runs only)
OPENAI_MODEL_EXTRACT=                    # GPT-6 Luna id (evidence extraction)
LLM_RUN_CAP_USD=3
LLM_DAY_CAP_USD=40
